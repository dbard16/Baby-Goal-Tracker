EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: force the coach to use canned dev-mode replies (data/mockCoachResponses.ts)
# even when a real Anthropic key is set. Auto-enabled if the key above is unset/placeholder.
EXPO_PUBLIC_MOCK_COACH=false
